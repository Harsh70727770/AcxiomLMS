@model IEnumerable<AcxiomLMS.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollments";
    ViewData["BodyClass"] = "enrollment-body";   /* ✔ Background applied */
}

<div class="enrollment-wrapper">
    <h2 class="mb-3">Enrollments</h2>

    <a asp-action="Assign" class="btn btn-primary mb-3">+ Assign New</a>

    <div class="enrollment-card">
        <table class="table table-bordered table-striped bg-white" style="border-radius:10px;">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Course</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.User?.FullName (@e.User?.Role)</td>
                        <td>@e.Course?.Title</td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-danger">Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
