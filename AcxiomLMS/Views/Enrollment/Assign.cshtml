@{
    ViewData["Title"] = "Assign Course - Acxiom LMS";
}
@{
    ViewData["BodyClass"] = "enrollment-body";
}

<h2>Assign Course to User</h2>

<form method="post" asp-action="Assign" class="mt-3">
    <div class="mb-3">
        <label class="form-label">User</label>
        <select name="userId" class="form-select" asp-items="ViewBag.Users">
            <option value="">-- Select User --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Course</label>
        <select name="courseId" class="form-select" asp-items="ViewBag.Courses">
            <option value="">-- Select Course --</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Assign</button>
    <a asp-action="Index" class="btn btn-secondary">View Enrollments</a>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }
    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success mt-3">@ViewBag.Success</div>
    }
</form>
